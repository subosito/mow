# Optional mow config — copy to $MOW_HOME/config.yaml (default ~/.mow/config.yaml)
# or pass --config path. Set MOW_HOME to relocate the whole user data root.
#
# Env always wins for secrets and common overrides (ANTHROPIC_* preferred on
# the anthropic-messages wire; MOW_* always wins):
#   OPENAI_BASE_URL / ANTHROPIC_BASE_URL / MOW_BASE_URL
#   OPENAI_API_KEY  / ANTHROPIC_API_KEY  / MOW_API_KEY
#   OPENAI_MODEL    / ANTHROPIC_MODEL    / MOW_MODEL
#   MOW_WIRE (openai-chat-completions | openai-responses | anthropic-messages)

workspace: .

# Optional OpenTelemetry (OTLP). Empty endpoint = disabled (default).
# Host/user config only — not honored from project .mow/config.
# Env: MOW_OTEL_ENDPOINT or OTEL_EXPORTER_OTLP_ENDPOINT
# otel:
#   endpoint: http://127.0.0.1:4318   # OTLP/HTTP collector
#   protocol: http                    # http (default); grpc reserved
#   service_name: mow
#   # headers:
#   #   authorization: Bearer …

llm:
  # Client wire. Default: openai-chat-completions when unset.
  # Omit wire to auto-align from GET /v1/models for the active model
  # (e.g. claude-* → anthropic-messages so Anthropic prompt cache works).
  # Explicit wire is never overridden by the catalog.
  # wire: openai-chat-completions
  # wire: anthropic-messages
  # wire: openai-responses   # POST /v1/responses (OpenAI Responses API)
  # base_url: https://api.openai.com/v1   # or any OpenAI-compatible /v1
  # api_key_env: OPENAI_API_KEY
  # model: gpt-5-mini                 # chat agent loop (tools + reasoning)
  # model: deepseek-chat              # or any OpenAI-compatible id
  # effort: medium                    # none|low|medium|high (optional; not part of model id)
  # Provider-executed tools declared in the request. The provider runs these
  # server-side: mow makes no network call for them, so they are not path
  # jailed and produce no tool.start/tool.end events (their cost lands in
  # usage). Support is per model, not per wire — declaring one a model cannot
  # run makes it emit a call nothing answers, which shows up as stray tokens
  # in the reply. Omit unless the model is known to support it.
  # native_tools:
  #   - type: web_search
  #   # Gemini-family → body thinking_budget; other OpenAI wires → reasoning_effort
  #   # Gateways map lean model ids to upstream tiers themselves
  # stream: true
  #
  # Optional system segments prepended *before* the compiled system prompt.
  # Use for product identity / provider preambles (e.g. "You are …").
  # When this applies to the model, mow omits its default "You are mow" identity
  # line so there is only one persona. Harness operating rules still follow.
  # Compiled system after prefix = [optional identity] + rules + AGENTS.md + skills.
  # Each list item is a separate segment. Limit by model id with globs
  # (case-insensitive); omit system_prefix_models to apply for every model.
  # system_prefix:
  #   - "…"
  # system_prefix_models:
  #   - "family-*"
  # (Only $MOW_HOME/config.yaml / --config; not project .mow/config.)

  # Side-lane model ids (same base_url/key as chat). Chat stays on `model` above.
  # Use whatever ids your provider/gateway exposes. Chat stays on `model` above.
  # generate.* / understand.* → tools generate_* / understand_*
  # generate:
  #   image: gpt-image-1                  # or your gateway's image model id
  #   speech: tts-1
  #   speech_voice: alloy                 # provider voice id (optional; default alloy)
  #   video: …                            # if your endpoint supports video
  # understand:
  #   image: gpt-5                        # vision-capable chat model id
  #   voice: whisper-1
  #   video: …

tools:
  # Secure default when omitted: read, glob, grep
  enable:
    - read
    - glob
    - grep
  # Power tools: CLI --allow-write / --allow-shell, or list them here:
  #   - write
  #   - edit
  #   - bash
  # Media (also set matching llm.generate.* / llm.understand.* model ids):
  #   - generate_image
  #   - generate_speech
  #   - generate_video
  #   - understand_image
  #   - understand_voice
  #   - understand_video

policy:
  max_turns: 120                  # LLM round-trips per Prompt; -1 = unlimited
  bash_timeout_sec: 300           # per bash call (default); builds/test suites need minutes
  max_bash_timeout_sec: 900       # ceiling a single call may request via timeout_sec
  max_read_bytes: 524288          # 512 KiB per read (default)
  max_context_chars: 100000       # soft history floor (default); auto-scales from context_window; -1 disables
  compact_ratio: 0.8              # of gateway context_window when auto-scaling (1M → ~800k tok-eq history)
  max_tool_result_chars: 24000    # cap each tool result in model history (default)
  max_parallel_tools: 8           # concurrent tools per assistant batch; 1 = sequential
  # extra_roots:  # PATH or PATH:ro (read-only)
  # - /abs/shared:ro                  # more FS trees for read/write/edit/glob/grep
  #   - /path/to/sibling-repo     # user/host config only (not project .mow/config)
  # CLI: --extra-root PATH (repeatable)

skills:
  # dirs: [/path/to/skills]   # *.md files appended to system prompt
  # Project skills: workspace/.mow/skills when trusted (mow trust, or MOW_TRUST_PROJECT=1)
  # Project config: workspace/.mow/config.yaml only when trusted
  # hashline: true   # optional N:hash|line read + line_hash edit

session:
  # dir: # default $MOW_HOME/sessions

# Optional packs — packages under ext/<name>; config key extensions.<name>
# extensions:
#   acp:
#     # External peers (any ACP command). "Subagent" in other harnesses = named agent here.
#     agents:
#       - name: peer-agent
#         command: [env, ANTHROPIC_MODEL=claude-sonnet-4, npx, -y, "@agentclientprotocol/claude-agent-acp"]
#         # timeout_sec: 600
#     # Native mow multi-model peers → mow acp --model … (same acp_delegate tool)
#     mow_agents:
#       peer-agent:
#         model: gpt-5-mini      # required
#         # allow_write: true       # default true
#         # allow_shell: true       # default true
#         # timeout_sec: 600        # default 600
#         # effort: high            # optional --effort on the peer
#         # dir: /abs/path
#         # extra_args: [--stream]
#   job:
#     schedules:
#       - id: hourly
#         every: 1h
#         goal: fix-ci
#   ops:                              # pack settings only (ext/ops)
#     # root:                            # default $MOW_HOME/ops
#     # log_max_lines: 200
#     # log_max_bytes: 262144
#     # Named profiles live under $MOW_HOME/ops/<name>/ (not in this file):
#     #   config.yaml   services, actions, acp peers, model, every, prompt
#     #   prompt.md     system instructions
#     #   incidents/    durable tickets
#     # Example profile config.yaml:
#     #   every: 15m
#     #   model: gpt-5-mini               # optional; or rely on $MOW_HOME/config.yaml
#     #   services:
#     #     - name: api
#     #       logs: [/var/log/api/app.log]
#     #       actions:
#     #         status:  [systemctl, is-active, api.service]
#     #         restart: [systemctl, restart, api.service]
#     #       acp: api-peer
#     #   acp:
#     #     agents:
#     #       - name: api-peer
#     #         command: [mow, acp]
#     #         dir: /path/to/api/repo
#     # Then: mow ops run api-stack --once


# Claude Code plugin hooks bridge (ext/cmdhook). Runs a plugin hooks.json
# against mow's hook system — e.g. context-mode. Same trust bar as shell.
# extensions:
#   cmdhook:
#     root: /path/to/plugin
#     hooks_file: hooks/hooks.json
#     timeout_sec: 10
