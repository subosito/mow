# Optional mow config — copy to $MOW_HOME/config.yaml (default ~/.mow/config.yaml)
# or pass --config path. Set MOW_HOME to relocate the whole user data root.
#
# Env always wins for secrets and common overrides (ANTHROPIC_* preferred on
# the anthropic-messages wire; MOW_* always wins):
#   OPENAI_BASE_URL / ANTHROPIC_BASE_URL / MOW_BASE_URL
#   OPENAI_API_KEY  / ANTHROPIC_API_KEY  / MOW_API_KEY
#   OPENAI_MODEL    / ANTHROPIC_MODEL    / MOW_MODEL
#   MOW_WIRE (openai-chat-completions | openai-responses | anthropic-messages)

workspace: .

# Optional OpenTelemetry (OTLP). Empty endpoint = disabled (default).
# There is no otel.enabled — a set endpoint turns the exporter on.
# Host/user config only — not honored from project .mow/config.
# Env: MOW_OTEL_ENDPOINT or OTEL_EXPORTER_OTLP_ENDPOINT
# otel:
#   endpoint: http://127.0.0.1:4318   # OTLP/HTTP collector
#   protocol: http                    # http (default); grpc reserved
#   service_name: mow
#   # headers:
#   #   authorization: Bearer …

llm:
  # Client wire. Default: openai-chat-completions when unset.
  # Omit wire to auto-align from GET /v1/models for the active model
  # (e.g. claude-* → anthropic-messages so Anthropic prompt cache works).
  # Explicit wire is never overridden by the catalog.
  # wire: openai-chat-completions
  # wire: anthropic-messages
  # wire: openai-responses   # POST /v1/responses (OpenAI Responses API)
  # base_url: https://api.openai.com/v1   # or any OpenAI-compatible /v1
  # api_key_env: OPENAI_API_KEY
  # model: gpt-5-mini                 # chat agent loop (tools + reasoning)
  # model: deepseek-chat              # or any OpenAI-compatible id
  # effort: medium                    # none|low|medium|high (optional; not part of model id)
  # first_byte_timeout_sec: 300     # streaming: max wait for response headers/first byte
  #                                 # (default 300; a full timeout is hard, not retried).
  #                                 # Host/user config only — project configs cannot set it.
  # call_timeout_sec: 120           # non-streaming: per-attempt cap (default 120).
  #                                 # Host/user config only, like first_byte_timeout_sec.
  # Provider-executed tools declared in the request. USUALLY LEAVE UNSET: when
  # the gateway publishes native_tools per model on GET /v1/models, mow uses
  # that automatically, so capability lives in one place instead of being
  # repeated in every client config. Set this only to override — to disable a
  # published tool, or to declare one a plain provider does not advertise.
  #
  # The provider runs these server-side: mow makes no network call for them, so
  # they are not path jailed and produce no tool.start/tool.end events (their
  # cost lands in usage, and run.end reports provider_tool_calls).
  #
  # Support is per model AND per wire — the entry shape differs by provider:
  #   openai-responses    - {type: web_search}      (OpenAI, xAI)
  #                       - {type: x_search}        (xAI only)
  #   anthropic-messages  - {type: web_search_20250305, name: web_search}
  #                         Anthropic versions this type by date (…20260209,
  #                         …20260318, …). Newer adds controls; older is the
  #                         safe default, since a gateway or model that does
  #                         not know a version rejects the request outright.
  #   chat-completions    - no server-tool channel. A declaration here is
  #                         SILENTLY IGNORED: no error, no search, just an
  #                         answer from training data that reads as current.
  #                         Verified: gpt-5.x on this wire returns stale facts
  #                         while grok-4.5 on responses searches and cites.
  #                         OpenAI's own web_search is Responses-only.
  #
  # Declaring a tool the model cannot run makes it emit a call nothing answers,
  # which leaks into the reply as stray tokens. Omit unless verified.
  # native_tools:
  #   - type: web_search
  #   # Gemini-family → body thinking_budget; other OpenAI wires → reasoning_effort
  #   # Gateways map lean model ids to upstream tiers themselves
  # stream: true
  # max_tokens: 32000               # reply cap for wires that require it (anthropic-messages).
  #                                 # Default: the model's published max_output_tokens, else 8192.
  # prompt_cache: short             # short (default) | long (1h TTL) | none; bools still accepted.
  #                                 # long pays off when think-time gaps exceed the ~5min default
  #                                 # window: every lapsed window re-bills the whole prefix.
  #
  # Optional system segments prepended *before* the compiled system prompt.
  # Use for product identity / provider preambles (e.g. "You are …").
  # When this applies to the model, mow omits its default "You are mow" identity
  # line so there is only one persona. Harness operating rules still follow.
  # Compiled system after prefix = [optional identity] + rules + AGENTS.md + skills.
  # Each list item is a separate segment. Limit by model id with globs
  # (case-insensitive); omit system_prefix_models to apply for every model.
  # system_prefix:
  #   - "…"
  # system_prefix_models:
  #   - "family-*"
  # (Only $MOW_HOME/config.yaml / --config; not project .mow/config.)
  #
  # Some subscription-OAuth routes gate on the first system segment and answer
  # HTTP 429 rate_limit_error when it is missing — the request looks unthrottled
  # otherwise, so it reads as a quota problem rather than a shape problem. If a
  # provider documents such a preamble, put it here as its own first segment;
  # folding it into another segment does not satisfy the check.

tools:
  # Built-in defaults: read, glob, grep. You normally never touch enable —
  # power tools have simple knobs that match the CLI flags:
  # write: true    # add write + edit  (= --allow-write)
  # shell: true    # add bash          (= --allow-shell)
  # Host/user config only; a project .mow/config cannot set write/shell.
  # hashline: true   # optional N:hash|line read + line_hash edit
  #
  # enable is the explicit override form for hosts (rarely needed):
  #   enable: [read, glob, grep, write, edit, bash]
  # Media tools (generate_*/understand_*) are NOT listed here: linking
  # packs/media + configuring extensions.media registers them automatically.

policy:
  # max_turns: 200                # cap LLM round-trips per Prompt. Default: unlimited —
  #                               # a run ends when done/stuck/cancelled or over an
  #                               # explicit budget, not merely because it was long.
  bash_timeout_sec: 300           # per bash call (default); builds/test suites need minutes
  max_bash_timeout_sec: 900       # ceiling a single call may request via timeout_sec
  max_read_bytes: 524288          # 512 KiB per read (default)
  max_context_chars: 100000       # soft history floor (default); auto-scales from context_window; -1 disables
  compact_ratio: 0.5              # of gateway context_window when auto-scaling (1M → ~500k tok-eq history, hard-capped)
  max_tool_result_chars: 24000    # cap each tool result in model history (default)
  # max_run_tokens: 2000000       # hard ceiling on input+output tokens for ONE prompt.
  #                               # max_turns bounds round-trips; this bounds spend.
  # max_run_usd: 5.00             # same ceiling in USD. Needs published pricing:
  #                               # mow refuses to start if the model has no price,
  #                               # rather than offering a limit that never fires.
  # compact_summary: false          # replace the deterministic compaction stub with a
  #                                 # structured LLM summary (goal/decisions/next steps).
  #                                 # Costs one extra call per compaction; pays for itself
  #                                 # only if it stops the model re-exploring afterwards.
  max_parallel_tools: 8           # concurrent tools per assistant batch; 1 = sequential
  # extra_roots:                  # PATH or PATH:ro (read-only)
  #   - /abs/shared:ro            # more FS trees for read/write/edit/glob/grep
  #   - /path/to/sibling-repo     # user/host config only (not project .mow/config)
  # CLI: --extra-root PATH (repeatable)

# Opt-in OS jail for bash + proc_start (Linux bubblewrap). Default none =
# unsandboxed --allow-shell (today's behavior). "bwrap" binds the workspace
# and extra_roots the same way as the FS jail; $HOME is not bound unless it
# is one of those. Network stays on. Missing bwrap = hard error, no fallback.
# CLI: --sandbox=bwrap  (ignored unless --allow-shell / tools.enable includes bash)
# policy:
#   sandbox: bwrap                # none | bwrap

skills:
  # dirs: [~/skills]           # skill dirs; each skill is <name>/SKILL.md (folder layout)
  #                            # host/user config only; project .mow/skills is added when trusted
  # selector: true             # default on: load only skills whose folder name appears in the first prompt
  # selector: false            # off: load every configured skill at startup
  # explicit: [docker, go]     # load named skills unconditionally regardless of selector (CLI: --skill)
  # Project skills: workspace/.mow/skills when trusted (mow trust, or MOW_TRUST_PROJECT=1)
  # Project config: workspace/.mow/config.yaml only when trusted

session:
  # dir: # default $MOW_HOME/sessions

# Optional packs — config key extensions.<name>. Unused keys stay as yaml
# blobs; lean mow ignores media/ops/job/review/goal.
# extensions:
#   mowi:                             # host $MOW_HOME only (not project .mow/)
#     mow_bin: mow                    # lean default; TUI spawn
#     # mow_bin: mow-full             # --mow-bin > $MOW_BIN > this > mow
#     theme: catppuccin-mocha
